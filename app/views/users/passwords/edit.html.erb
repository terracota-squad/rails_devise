<h2 class="form-heading"><%= t('.change_your_password') %></h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <div class="d-flex flex-column justify-content-center align-items-center">
    <%= render "users/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="mb-3 w-50">
      <%= f.label :password, t('.new_password'), class: "form-label" %>
      <% if @minimum_password_length %>
        <em>(<%= t('users.shared.minimum_password_length', count: @minimum_password_length) %>)</em>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class:"form-control border-dark-subtle" %>
    </div>

    <div class="mb-3 w-50">
      <%= f.label :password_confirmation, t('.confirm_new_password'), class: "form-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class:"form-control border-dark-subtle" %>
    </div>

    <div class="mb-3 d-flex align-items-center justify-content-center">
      <%= f.submit t('.change_my_password'), class:"btn btn-lg btn-primary" %>
    </div>

    <%= render "users/shared/links" %>

  </div>
<% end %>
