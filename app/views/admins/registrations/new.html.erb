<% content_for :title, t('.title', resource: resource_class.model_name.human) %>
<h2 class="form-heading"><%= t('.sign_up') %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <div class="d-flex flex-column justify-content-center align-items-center">
    <%= render "admins/shared/error_messages", resource: resource %>

    <div class="mb-3 w-50">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class:"form-control border-dark-subtle" %>
    </div>

    <div class="mb-3 w-50">
      <%= f.label :password, class: "form-label" %>
      <% if @minimum_password_length %>
        <em>(<%= t('admins.shared.minimum_password_length', count: @minimum_password_length) %>)</em>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class:"form-control border-dark-subtle" %>
    </div>

    <div class="mb-3 w-50">
      <%= f.label :password_confirmation, class: "form-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class:"form-control border-dark-subtle" %>
    </div>

    <div class="mb-3 d-flex align-items-center justify-content-center">
      <%= f.submit t('.sign_up'), class:"btn btn-lg btn-primary" %>
    </div>

    <%= render "admins/shared/links" %>

  </div>
<% end %>
