<% content_for :title, t('.title', resource: resource_class.model_name.human) %>
<h2 class="form-heading"><%= t('.sign_in') %></h2>

<% if flash[:alert] %>
  <div class="d-flex justify-content-center" role="alert">
    <div class="alert alert-danger alert-dismissible fade show mb-3 w-75">
      <%= flash[:alert] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
<% end %>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="d-flex flex-column justify-content-center align-items-center">

    <div class="mb-3 w-50">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class:"form-control border-dark-subtle" %>
    </div>

    <div class="mb-3 w-50">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class:"form-control border-dark-subtle" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="form-check mb-3 w-50">
        <%= f.check_box :remember_me, class:"form-check-input border-dark-subtle" %>
        <%= f.label :remember_me, class:"form-check-label" %>
      </div>
    <% end %>

    <div class="mb-3 d-flex align-items-center justify-content-center">
      <%= f.submit t('.sign_in'), class:"btn btn-lg btn-primary" %>
    </div>

    <%= render "users/shared/links" %>
    <%= link_to t('links.sign_in_as_admin'), new_admin_session_path %>

  </div>
<% end %>
