<h2 class="form-heading"><%= t('.forgot_your_password') %></h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <div class="d-flex flex-column justify-content-center align-items-center">
    <%= render "users/shared/error_messages", resource: resource %>

    <div class="mb-3 w-50">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class:"form-control border-dark-subtle" %>
    </div>

    <div class="mb-3 d-flex align-items-center justify-content-center">
      <%= f.submit t('.send_me_reset_password_instructions'), class:"btn btn-lg btn-outline-dark" %>
    </div>

    <%= render "users/shared/links" %>

  </div>
<% end %>
